{"version":3,"kind":"Notebook","sha256":"acb383b26b88b7a7136392cfaa23b16b8fca249e699318e33739b1f1df2195cc","slug":"chapter8","location":"/chapter8.md","dependencies":[],"frontmatter":{"title":"Chapter 8","subtitle":"Function chebfft, Programs p18, p19, p20","kernelspec":{"name":"julia-1.11","display_name":"Julia 1","language":"julia"},"github":"https://github.com/tobydriscoll/SpectralMethodsTrefethen.jl","numbering":{"title":{"enabled":false},"code":{"enabled":false},"equation":{"enabled":false},"heading_1":{"enabled":false},"heading_2":{"enabled":false},"heading_3":{"enabled":false},"heading_4":{"enabled":false},"heading_5":{"enabled":false},"heading_6":{"enabled":false}},"math":{"\\float":{"macro":"\\mathbb{F}"},"\\real":{"macro":"\\mathbb{R}"},"\\complex":{"macro":"\\mathbb{C}"},"\\nat":{"macro":"\\mathbb{N}"},"\\integer":{"macro":"\\mathbb{Z}"},"\\rmn":{"macro":"\\mathbb{R}^{#1 \\times #2}"},"\\dd":{"macro":"\\frac{d #1}{d #2}"},"\\ddd":{"macro":"\\frac{d^2 #1}{d #2^2}"},"\\pp":{"macro":"\\frac{\\partial #1}{\\partial #2}"},"\\ppp":{"macro":"\\frac{\\partial^2 #1}{\\partial #2^2}"},"\\ppdd":{"macro":"\\frac{\\partial^2 #1}{\\partial #2 \\partial #3}"},"\\abs":{"macro":"\\left\\lvert #1 \\right\\rvert"},"\\norm":{"macro":"\\left\\lVert #1 \\right\\rVert"},"\\twonorm":{"macro":"\\norm{#1}_2"},"\\onenorm":{"macro":"\\norm{#1}_1"},"\\infnorm":{"macro":"\\norm{#1}_\\infty"},"\\anynorm":{"macro":"\\norm{#1}_#2"},"\\innerprod":{"macro":"\\langle #1,#2 \\rangle"},"\\pr":{"macro":"^{(#1)}"},"\\kron":{"macro":"#1 \\otimes #2"},"\\macheps":{"macro":"\\epsilon_\\text{mach}"},"\\fl":{"macro":"\\operatorname{fl}"},"\\diag":{"macro":"\\operatorname{diag}"},"\\ign":{"macro":"\\operatorname{sign}"},"\\Re":{"macro":"\\operatorname{Re}"},"\\Im":{"macro":"\\operatorname{Im}"},"\\ee":{"macro":"\\times 10^"},"\\floor":{"macro":"\\lfloor#1\\rfloor"}},"abbreviations":{"SMiM":"Spectral Methods in MATLAB","IVP":"initial-value problem","BVP":"boundary-value problem","TPBVP":"two-point boundary-value problem","SVD":"singular value decomposition","EVD":"eigenvalue decomposition","SPD":"symmetric positive definite","HPD":"hermitian positive definite","PDE":"partial differential equation","ODE":"ordinary differential equation","FFT":"fast Fourier transform"},"source_url":"https://github.com/tobydriscoll/SpectralMethodsTrefethen.jl/blob/main/chapter8.md","edit_url":"https://github.com/tobydriscoll/SpectralMethodsTrefethen.jl/edit/main/chapter8.md","exports":[{"format":"md","filename":"chapter8.md","url":"/build/chapter8-1a96c41e71d1b5f394af4b671749f364.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"chebfft","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"f0DLDGkurB"}],"identifier":"chebfft","label":"chebfft","html_id":"chebfft","implicit":true,"key":"v0kV8SV7lY"},{"type":"include","file":"SpectralMethodsTrefethen/src/chebfft.jl","literal":true,"html_id":"chebfft-1","children":[{"type":"code","value":"DCT(v) = FFTW.r2r(v, FFTW.REDFT00)\nDST(v) = FFTW.r2r(v, FFTW.RODFT00)\n\n\"\"\"\n    chebfft(v)\nDifferentiate values given at Chebyshev points via the FFT.\n\"\"\"\nfunction chebfft(v)\n    N = length(v) - 1\n    (N == 0) && return zero(v)\n    x = [sinpi(k / 2N) for k in N:-2:-N]\n    v̂ = DCT(v)\n    w = similar(v)\n    if N > 1\n        ξ = 1:N-1\n        q = DST(-ξ .* v̂[2:N])\n        w[2:N] = @. -q / (2N * sqrt(1 - x[2:N]^2))\n    end\n    w[1] = N/2 * v̂[N+1] + sum(n^2 * v̂[n+1] for n in 0:N-1) / N\n    w[N+1] = (-1)^(N+1) * N/2 * v̂[N+1] +\n        sum((-1)^(n+1) * n^2 * v̂[n+1] for n in 0:N-1) / N\n    return w\nend","lang":"julia","showLineNumbers":true,"label":"chebfft","identifier":"chebfft","filename":"chebfft","html_id":"chebfft","key":"Y1pciEhCpc"}],"key":"AjCyVz3LcQ"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"I have structured my implementation of ","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"bZ8L5hwfOh"},{"type":"inlineCode","value":"chebfft","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"BNjCbEZwBO"},{"type":"text","value":" to take advantage of the factor of 4 efficiency mentioned in the text. The ","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"afZHeVlfcR"},{"type":"inlineCode","value":"FFTW","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"ilKejk9CHg"},{"type":"text","value":" package gives us access to the discrete cosine and sine transforms, which I designate as ","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"LUMKFCXGLc"},{"type":"inlineCode","value":"DCT","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"wvTgpnH0pE"},{"type":"text","value":" and ","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"Gi1yoWs5Y8"},{"type":"inlineCode","value":"DST","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"Dylwb8wrKW"},{"type":"text","value":". The DCT implicitly assumes even symmetry, which avoids the need to create an extended vector of the data. Once we differentiate cosines to get sines, the DST is the natural choice for the inverse transform; it expects us to omit the values we know to be zero at the endpoint wavenumbers. Everything else operates much like it does in the MATLAB code.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"QCxCP2g0cu"}],"key":"rnpaN2TdIg"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"inlineCode","value":"similar","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"nrc8I5C5To"}],"key":"osBSLFyr16"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"QUnl9XGq2F"},{"type":"inlineCode","value":"similar","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"Qo8IpvXZI5"},{"type":"text","value":" function creates an uninitialized array with the same size and element type as the given array. We have to be careful here not to specify either a real or complex array, since we want the result to have the same type as the input. We could get a valid result using ","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"gLywauK22s"},{"type":"inlineCode","value":"w = copy(v)","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"nu2tTB28K0"},{"type":"text","value":", but that causes an unnecessary copy of the data.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"bJ7SoUXpA7"}],"key":"G8jN7TBEk1"}],"icon":false,"key":"bIYmGWe464"},{"type":"heading","depth":2,"position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Program 18","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"OogxRwpbK9"}],"identifier":"program-18","label":"Program 18","html_id":"program-18","implicit":true,"key":"gd2xoudG4Y"},{"type":"include","file":"SpectralMethodsTrefethen/src/scripts/p18.jl","literal":true,"children":[{"type":"code","value":"using CairoMakie, LaTeXStrings, SpectralMethodsTrefethen, ForwardDiff\n\"p18 - Chebyshev differentiation via FFT (compare p11)\"\nfunction p18()\n    f(x) = exp(x) * sin(5x)\n    fprime(x) = ForwardDiff.derivative(f, x)\n    fig = Figure()\n    for (i, N) in enumerate([10, 20])\n        _, x = cheb(N)\n        v = f.(x)\n\n        Axis(fig[i, 1]; title=latexstring(\"\\$u(x),\\\\,  N=$N\\$\"))\n        scatter!(fig[i, 1], x, v)\n        lines!(fig[i, 1], -1..1, f)\n\n        error = chebfft(v) - fprime.(x)\n        Axis(fig[i, 2]; title=latexstring(\"error in \\$u'(x),\\\\,  N=$N\\$\"))\n        scatter!(fig[i, 2], x, error)\n        lines!(fig[i, 2], -1..1, chebinterp(error))\n    end\n    return fig\nend","lang":"julia","showLineNumbers":true,"label":"p18","identifier":"p18","filename":"p18","html_id":"p18","key":"jTMfciDj9D"}],"key":"O3WhwmkeUG"},{"type":"heading","depth":3,"position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Output 18","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"SHqu5ESGBt"}],"identifier":"output-18","label":"Output 18","html_id":"output-18","implicit":true,"key":"whHraDsy21"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"I made a change compared to both Output 18 from ","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"RoyqxK3lPY"},{"type":"emphasis","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"abbreviation","title":"Spectral Methods in MATLAB","children":[{"type":"text","value":"SMiM","key":"yMTYOJnRAC"}],"key":"rI4bgi1OOJ"}],"key":"DfTV50ZRTJ"},{"type":"text","value":" and ","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"YlgQmun4I5"},{"type":"crossReference","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Output 11","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"f4dVASTAeU"}],"identifier":"output11","label":"output11","kind":"block:notebook-code","template":"Notebook-code","resolved":true,"html_id":"output11","remote":true,"url":"/chapter6","dataUrl":"/chapter6.json","key":"SC7LCK1VIN"},{"type":"text","value":". For the right-hand column, I show the discrete error as markers as before, but instead of connecting them with straight lines, I use ","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"zH88MDBzQD"},{"type":"inlineCode","value":"chebinterp","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"W6Hrx7jjCt"},{"type":"text","value":" to show the error as a continuous function. (By linearity, the interpolant of the error is the error of the interpolant.)","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"bakBOBOun3"}],"key":"JRHmSg6xwc"}],"key":"KRo4f7xu5k"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"julia","executable":true,"value":"using SpectralMethodsTrefethen\np18()","identifier":"output18-code","html_id":"output18-code","key":"ZOCSzrLlax"},{"type":"outputs","id":"4bbEz8LZ_WmwzXNSz3xd2","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":1,"metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"3f2f69dbbf4f4c4620cc12d6d8783e62","path":"/build/3f2f69dbbf4f4c4620cc12d6d8783e62.png"},"text/html":{"content_type":"text/html","hash":"469f2842d25a8f7dd565ecaa9b0cc68b","path":"/build/469f2842d25a8f7dd565ecaa9b0cc68b.html"}}},"identifier":"output18-outputs-0","html_id":"output18-outputs-0","key":"BXRzWRU2NZ"}],"identifier":"output18-outputs","html_id":"output18-outputs","key":"k7KnRZb2vw"}],"label":"output18","identifier":"output18","html_id":"output18","key":"hjgfpp7QCM"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"I like this here because it dispels the appearance that the discrete errors are local extrema.","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"BeVHhdSfuc"}],"key":"pygXr12i3x"},{"type":"heading","depth":2,"position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Program 19","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"dcsGtrMW6L"}],"identifier":"program-19","label":"Program 19","html_id":"program-19","implicit":true,"key":"tr0RJ8tJSd"},{"type":"include","file":"SpectralMethodsTrefethen/src/scripts/p19.jl","literal":true,"children":[{"type":"code","value":"using CairoMakie, LaTeXStrings, FFTW, SpectralMethodsTrefethen\n\"p19 - 2nd-order wave eq. on Chebyshev grid (compare p6)\"\nfunction p19(N=80, tmax=4, Δt=8/N^2)\n    _, x = cheb(N)\n    v = @. exp(-200x^2)\n    vold = @. exp(-200 * (x - Δt)^2)\n\n    # Time-stepping by leap frog formula:\n    tplot = 0.025\n    plotgap = round(Int, tplot / Δt)\n    Δt = tplot / plotgap\n    ntime = round(Int, tmax / Δt)\n    data = hcat(v, zeros(N+1, ntime))\n    t = Δt * (0:ntime)\n    for i = 1:ntime\n        w = chebfft(chebfft(v))\n        w[[1, N+1]] .= 0\n        vnew = 2v - vold + Δt^2 * w\n        data[:, i+1] = vnew\n        vold, v = v, vnew\n    end\n\n    # Plot results:\n    return heatmap(x, t[1:plotgap:end], data[:, 1:plotgap:end];\n        colormap=:redsblues, colorrange=(-1, 1),\n        axis=(xlabel=L\"x\", ylabel=L\"t\"))\nend","lang":"julia","showLineNumbers":true,"label":"p19","identifier":"p19","filename":"p19","html_id":"p19","key":"idYgxzH4eg"}],"key":"IbwrbBnAIz"},{"type":"heading","depth":3,"position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"Output 19","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"OZY4X6bSY7"}],"identifier":"output-19","label":"Output 19","html_id":"output-19","implicit":true,"key":"RnNHGm1hy4"}],"key":"lxRRPjcx4F"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"julia","executable":true,"value":"p19()","identifier":"output19-code","html_id":"output19-code","key":"THCvTJXjtk"},{"type":"outputs","id":"zpFsoKIoQDoQav0PdFQNc","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":2,"metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"9be7f9c81ce8abcedbb47e81267dc474","path":"/build/9be7f9c81ce8abcedbb47e81267dc474.png"},"text/html":{"content_type":"text/html","hash":"c25ee113aa154650d6ff21bdcf5ebf23","path":"/build/c25ee113aa154650d6ff21bdcf5ebf23.html"}}},"identifier":"output19-outputs-0","html_id":"output19-outputs-0","key":"PAwHAENK18"}],"identifier":"output19-outputs","html_id":"output19-outputs","key":"oxFMuTvF0k"}],"label":"output19","identifier":"output19","html_id":"output19","key":"iWSPM9vr5I"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"The colormap makes it perfectly clear that the bump inverts whenever it reflects from a boundary. The animation is fun as well:","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"pXSFfnXPLp"}],"key":"wPoMpxWfoo"},{"type":"include","file":"SpectralMethodsTrefethen/src/scripts/p19anim.jl","literal":true,"children":[{"type":"code","value":"using CairoMakie, Printf, LaTeXStrings\nusing FFTW, SpectralMethodsTrefethen\n\"p19anim - 2nd-order wave eq. on Chebyshev grid (compare p6)\"\nfunction p19anim(N=80, tmax=4, Δt=8/N^2)\n    _, x = cheb(N)\n\n    tplot = 0.005\n    plotgap = round(Int, tplot / Δt)\n    Δt = tplot / plotgap\n    ntime = round(Int, tmax / Δt)\n\n    # Time-stepping by leap frog formula:\n    time = Observable(0.0)\n    title = @lift latexstring(@sprintf(\"\\$t = %0.2f\\$\", $time))\n    v = Observable(@. exp(-200x^2))\n    vold = @. exp(-200 * (x - Δt)^2)\n    u = @lift chebinterp($v)\n    fig = lines(-1..1, u; axis=(; xlabel=L\"x\", title, limits=(-1, 1, -1, 1)))\n    anim = record(fig, \"p19anim-$N-$tmax.mp4\"; framerate=60) do io\n        recordframe!(io)\n        for n in 1:ntime\n            w = chebfft(chebfft(v[]))\n            w[[1, N+1]] .= 0\n            vnew = 2v[] - vold + Δt^2 * w\n            vold = v[]\n            v[] = vnew\n            time[] = n * Δt\n            iszero(mod(n, plotgap)) && recordframe!(io)\n        end\n      end\n    return anim\nend","lang":"julia","showLineNumbers":true,"label":"p19anim","identifier":"p19anim","filename":"p19anim","html_id":"p19anim","key":"KPZZMdXROV"}],"key":"e5NG2GDIoE"}],"key":"zMSlKdibNa"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"julia","executable":true,"value":"p19anim()","visibility":"show","key":"fb07A11A4G"},{"type":"outputs","id":"jf-lYmv1KiMdMyPgOq_PP","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","data":{"text/plain":"\"p19anim-80-4.mp4\""},"metadata":{},"execution_count":3},"key":"DDdII8bDWX"}],"visibility":"remove","key":"LTveXDMAKb"}],"data":{"tags":[]},"visibility":"show","key":"Ki9K3Jkfsc"},{"type":"block","children":[{"type":"image","url":"/build/p19anim-80-4-ef0af1695a55dcb1fa0746415c014408.mp4","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"label":"output19anim","identifier":"output19anim","html_id":"output19anim","key":"pxgUVUleIH","urlSource":"p19anim-80-4.mp4"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"Compare this solution to ","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"iauWJLHzlY"},{"type":"crossReference","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"Output 6","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"s5eNWu0XJV"}],"identifier":"output6anim","label":"output6anim","kind":"image","template":"Image","resolved":true,"html_id":"output6anim","remote":true,"url":"/chapter3","dataUrl":"/chapter3.json","key":"exR7SEHpKq"},{"type":"text","value":", where we had a variable speed on a periodic domain. This time, there is no visible error.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"YvBvXTG1A6"}],"key":"v7UYgMQHKN"},{"type":"heading","depth":2,"position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"Program 20-anim","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"qO9u6kWs3A"}],"identifier":"program-20-anim","label":"Program 20-anim","html_id":"program-20-anim","implicit":true,"key":"ak3OB0IigE"},{"type":"include","file":"SpectralMethodsTrefethen/src/scripts/p20anim.jl","literal":true,"children":[{"type":"code","value":"using CairoMakie, LaTeXStrings, Printf\nusing FFTW, SpectralMethodsTrefethen\n\"p20anim - 2nd-order wave eq. in 2D via FFT (compare p19)\"\nfunction p20anim(N=24, tmax=1, Δt=6/N^2)\n    # Grid and initial data:\n    x = y = cheb(N)[2]\n    DCT(v) = FFTW.r2r(v, FFTW.REDFT00)\n    DST(v) = FFTW.r2r(v, FFTW.RODFT00)\n    function fftderiv2(v)\n        N = length(v) - 1\n        x = [cospi(k / N) for k in 0:N]\n        v̂ = DCT(v)\n        dQ_dθ = DST(-(1:N-1) .* v̂[2:N]) / 2N    # omits n=0, n=N\n        d²Q_dθ² = DCT(-(0:N).^2 .* v̂) / 2N\n        w₂ = zero(v)    # return zero at boundaries\n        # Chain rule for θ -> x:\n        for n in 2:N\n            s² = 1 / (1 - x[n]^2)\n            s = sqrt(s²)\n            w₂[n] = s² * (d²Q_dθ²[n] - x[n] * dQ_dθ[n-1] * s)\n        end\n        return w₂\n    end\n\n    V = [exp(-40 * ((x - 0.4)^2 + y^2)) for x in x, y in y]\n    Vold = copy(V)\n    Vxx = similar(V)\n    Vyy = similar(V)\n\n    tplot = 1 / 60\n    plotgap = round(Int, tplot / Δt)\n    Δt = tplot / plotgap\n    ntime = round(Int, tmax / Δt)\n\n    # Time-stepping by leap frog formula:\n    time = Observable(0.0)\n    title = @lift latexstring(@sprintf(\"\\$t = %0.2f\\$\", $time))\n    V = Observable(V)\n    xx = yy = range(-1, 1, 151)\n    VV = @lift interp2dgrid($V, chebinterp, chebinterp, xx, yy)\n    fig = Figure()\n    ax = Axis(fig[1, 1]; xlabel=L\"x\", ylabel=L\"y\", aspect=DataAspect(),\n                limits = (-1, 1, -1, 1), title)\n    heatmap!(ax, xx, yy, VV; colorrange=(-0.75, 0.75), colormap=:cork)\n    anim = record(fig, \"p20anim-$N-$tmax.mp4\"; framerate=30) do io\n        recordframe!(io)\n        for n in 1:ntime\n            Vxx = mapslices(fftderiv2, V[]; dims=[1])\n            Vyy = mapslices(fftderiv2, V[]; dims=[2])\n            Vnew = 2V[] - Vold + Δt^2 * (Vxx + Vyy)\n            time[] = n * Δt\n            Vold, V[] = V[], Vnew\n            iszero(mod(n, plotgap)) && recordframe!(io)\n        end\n    end\n    return anim\nend","lang":"julia","showLineNumbers":true,"label":"p20anim","identifier":"p20anim","filename":"p20anim","html_id":"p20anim","key":"IceWtbJDNT"}],"key":"lyTjwc8K6k"},{"type":"heading","depth":3,"position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"Output 20-anim","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"Rd0sKrfkHv"}],"identifier":"output-20-anim","label":"Output 20-anim","html_id":"output-20-anim","implicit":true,"key":"ckMJ9b7sGS"}],"key":"S5pdHg2Iiv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"julia","executable":true,"value":"p20anim(32, 3)","visibility":"show","key":"t8Jc9GAhwZ"},{"type":"outputs","id":"5kvdF1y1oLj9d5-mE0PN2","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","data":{"text/plain":"\"p20anim-32-3.mp4\""},"metadata":{},"execution_count":4},"key":"bJat6oahhU"}],"visibility":"remove","key":"xGUVajWy8y"}],"data":{"tags":[]},"visibility":"show","key":"k2dbOdoh5m"},{"type":"block","children":[{"type":"image","url":"/build/p20anim-32-3-5fa2577a29c7340645bdadcc139e682d.mp4","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"label":"output20anim","identifier":"output20anim","html_id":"output20anim","key":"IWTMzx2zis","urlSource":"p20anim-32-3.mp4"},{"type":"paragraph","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"childr