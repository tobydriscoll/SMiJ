{"version":3,"kind":"Notebook","sha256":"791d927b20b8b17f457177072c0a0692ad9146f6f67090955d8c5cfae27f9699","slug":"chapter11","location":"/chapter11.md","dependencies":[],"frontmatter":{"title":"Chapter 11","subtitle":"Programs p28, p29","kernelspec":{"name":"julia-1.11","display_name":"Julia 1","language":"julia"},"github":"https://github.com/tobydriscoll/SpectralMethodsTrefethen.jl","numbering":{"title":{"enabled":false},"code":{"enabled":false},"equation":{"enabled":false},"heading_1":{"enabled":false},"heading_2":{"enabled":false},"heading_3":{"enabled":false},"heading_4":{"enabled":false},"heading_5":{"enabled":false},"heading_6":{"enabled":false}},"math":{"\\float":{"macro":"\\mathbb{F}"},"\\real":{"macro":"\\mathbb{R}"},"\\complex":{"macro":"\\mathbb{C}"},"\\nat":{"macro":"\\mathbb{N}"},"\\integer":{"macro":"\\mathbb{Z}"},"\\rmn":{"macro":"\\mathbb{R}^{#1 \\times #2}"},"\\dd":{"macro":"\\frac{d #1}{d #2}"},"\\ddd":{"macro":"\\frac{d^2 #1}{d #2^2}"},"\\pp":{"macro":"\\frac{\\partial #1}{\\partial #2}"},"\\ppp":{"macro":"\\frac{\\partial^2 #1}{\\partial #2^2}"},"\\ppdd":{"macro":"\\frac{\\partial^2 #1}{\\partial #2 \\partial #3}"},"\\abs":{"macro":"\\left\\lvert #1 \\right\\rvert"},"\\norm":{"macro":"\\left\\lVert #1 \\right\\rVert"},"\\twonorm":{"macro":"\\norm{#1}_2"},"\\onenorm":{"macro":"\\norm{#1}_1"},"\\infnorm":{"macro":"\\norm{#1}_\\infty"},"\\anynorm":{"macro":"\\norm{#1}_#2"},"\\innerprod":{"macro":"\\langle #1,#2 \\rangle"},"\\pr":{"macro":"^{(#1)}"},"\\kron":{"macro":"#1 \\otimes #2"},"\\macheps":{"macro":"\\epsilon_\\text{mach}"},"\\fl":{"macro":"\\operatorname{fl}"},"\\diag":{"macro":"\\operatorname{diag}"},"\\ign":{"macro":"\\operatorname{sign}"},"\\Re":{"macro":"\\operatorname{Re}"},"\\Im":{"macro":"\\operatorname{Im}"},"\\ee":{"macro":"\\times 10^"},"\\floor":{"macro":"\\lfloor#1\\rfloor"}},"abbreviations":{"SMiM":"Spectral Methods in MATLAB","IVP":"initial-value problem","BVP":"boundary-value problem","TPBVP":"two-point boundary-value problem","SVD":"singular value decomposition","EVD":"eigenvalue decomposition","SPD":"symmetric positive definite","HPD":"hermitian positive definite","PDE":"partial differential equation","ODE":"ordinary differential equation","FFT":"fast Fourier transform"},"source_url":"https://github.com/tobydriscoll/SpectralMethodsTrefethen.jl/blob/main/chapter11.md","edit_url":"https://github.com/tobydriscoll/SpectralMethodsTrefethen.jl/edit/main/chapter11.md","exports":[{"format":"md","filename":"chapter11.md","url":"/build/chapter11-7252dbe305b1c94f92f1d0e92340eead.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Program 28","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"pQ3Ap7uPD1"}],"identifier":"program-28","label":"Program 28","html_id":"program-28","implicit":true,"key":"so2SyNNLwa"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"I decomposed this program to make it easier to produce both versions of the output. The first function below computes the eigenmodes and returns a function that interpolates a requested mode number onto a finer grid. The other functions, which have much in common, call the first function and then plot the results in different ways.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"upqEH4WjF4"}],"key":"DyC3FwApNP"},{"type":"include","file":"SpectralMethodsTrefethen/src/scripts/p28.jl","literal":true,"children":[{"type":"code","value":"using CairoMakie, Printf\nusing ToeplitzMatrices, LinearAlgebra, SpectralMethodsTrefethen\n\"p28a, p28b - eigenmodes of Laplacian on the disk (compare p22)\"\np28() = p28a()\n\nfunction p28modes(N=25, M=20)\n    @assert isodd(N) && iseven(M) \"Must choose odd N and even M\"\n    # r coordinate, ranging from -1 to 1 (N must be odd):\n    N2 = div(N-1, 2)\n    Dr, r = cheb(N)\n    D²r = Dr^2\n    D₁ = D²r[2:N2+1, 2:N2+1]\n    D₂ = D²r[2:N2+1, N:-1:N2+2]\n    E₁ = Dr[2:N2+1, 2:N2+1]\n    E₂ = Dr[2:N2+1, N:-1:N2+2]\n\n    # θ coordinate, ranging from 0 to 2π (M must be even):\n    θ, _, D²θ = fourier(M)\n    M2 = div(M, 2)\n\n    # Laplacian in polar coordinates:\n    R = Diagonal(1 ./ r[2:N2+1])\n    J = [zeros(M2, M2) I; I zeros(M2, M2)]\n    Δ = kron(D₁ + R * E₁, I(M)) + kron(D₂ + R * E₂, J) + kron(R^2, D²θ)\n\n    # Compute eigenmodes:\n    λ, W = eigen(-Δ, sortby=abs)\n    λ = sqrt.(real(λ / λ[1]))\n\n    # Function to generate interpolated modes:\n    return function(k, θ, r)\n        V = reshape(real(W[:, k]), M, N2)\n        V = [zeros(M) V / maximum(abs, V)]                # BC and normalize\n        V = [V V[(@. mod1(M2 + (1:M), M)), N2+1:-1:1]]    # extend to r < 0\n        return λ[k], interp2dgrid(V, fourinterp, chebinterp, θ, r)\n    end\nend\n\nfunction p28a(N=25, M=20)\n    getmode = p28modes(N, M)\n    # Plot eigenmodes:\n    r, θ = range(-1, 1, 71), range(0, π, 111)\n    X = [r * cos(θ) for θ in θ, r in r]\n    Y = [r * sin(θ) for θ in θ, r in r]\n    zcirc = cispi.((-200:200) / 200)\n    fig = Figure(size=(640, 640))\n    for (i, mode) in pairs([1 3; 6 10])\n        λ, U = getmode(mode, θ, r)\n        str = @sprintf(\"Mode %d: λ = %0.11f\", mode, λ)\n        ax = Axis3(fig[i[1], i[2]]; title=str, aspect=:data)\n        surface!(ax, X, Y, 1.5 .+ U;\n            colormap=:redsblues, colorrange=(0.5, 2.5))\n        contour!(ax, X, Y, U; levels=[0], color=:darkblue, linewidth=1)\n        lines!(ax, reim(zcirc)...; color=:black, linewidth=2)\n        set_lights!(ax, [])\n        set_ambient_light!(ax, RGBf(0.85, 0.85, 0.85))\n        hidedecorations!(ax)\n        hidespines!(ax)\n    end\n    return fig\nend\n\nfunction p28b(N=25, M=20)\n    getmode = p28modes(N, M)\n    # Plot eigenmodes:\n    r, θ = range(-1, 1, 71), range(0, π, 111)\n    X = [r * cos(θ) for θ in θ, r in r]\n    Y = [r * sin(θ) for θ in θ, r in r]\n    zcirc = cispi.((-200:200) / 200)\n    fig = Figure(size=(640, 640))\n    modes = reshape(1:25, 5, 5)'\n    for (i, mode) in pairs(modes)\n        λ, U = getmode(mode, θ, r)\n        str = @sprintf(\"%0.4f\", λ)\n        ax = Axis(fig[i[1], i[2]]; title=str, titlefont=:regular, aspect=DataAspect())\n        contour!(ax, X, Y, U; levels=[0], color=:darkblue, linewidth=1)\n        lines!(ax, reim(zcirc)...; color=:black, linewidth=2)\n        hidedecorations!(ax)\n        hidespines!(ax)\n    end\n    return fig\nend","lang":"julia","showLineNumbers":true,"label":"p28","identifier":"p28","filename":"p28","html_id":"p28","key":"hhdz2EKgO0"}],"key":"jXw2Mc69Jo"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Note that I chose to plot using the parameterization ","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"wN2oMaOZYu"},{"type":"inlineMath","value":"r \\in [-1, 1]","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>r</mi><mo>∈</mo><mo stretchy=\"false\">[</mo><mo>−</mo><mn>1</mn><mo separator=\"true\">,</mo><mn>1</mn><mo stretchy=\"false\">]</mo></mrow><annotation encoding=\"application/x-tex\">r \\in [-1, 1]</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.5782em;vertical-align:-0.0391em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.02778em;\">r</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">∈</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mopen\">[</span><span class=\