 = Axis3(fig[1, 1]; xlabel=\"Re(z)\", ylabel=\"Im(z)\", zlabel=\"|Γ(z)|\")\n    G = @. min(6, abs(Γ))\n    plt = surface!(ax, x, y, G; colormap=:lajolla, colorscale=log2, colorrange=(1e-2, 6))\n    Colorbar(fig[1, 2], plt)\n    return fig\nend","lang":"julia","showLineNumbers":true,"label":"p31","identifier":"p31","filename":"p31","html_id":"p31","key":"syPXjVLUoW"}],"key":"yQsBArhURz"},{"type":"heading","depth":3,"position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"children":[{"type":"text","value":"Output 31","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"key":"gv19JUZii2"}],"identifier":"output-31","label":"Output 31","html_id":"output-31","implicit":true,"key":"DvSY0EovEl"}],"key":"gGJJwrC4i9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"julia","executable":true,"value":"p31()","identifier":"output31-code","html_id":"output31-code","key":"NAMALBp8hK"},{"type":"outputs","id":"_3yTsY0ms9bWKtLvHFcGm","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":8,"metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"d02fa68c81764c45fd5ffaa9d02bfcb2","path":"https://tobydriscoll.net/SMiJ/build/d02fa68c81764c45fd5ffaa9d02bfcb2.png"},"text/html":{"content_type":"text/html","hash":"52527c68e21f03af6f5506d808cf9bda","path":"https://tobydriscoll.net/SMiJ/build/52527c68e21f03af6f5506d808cf9bda.html"}}},"identifier":"output31-outputs-0","html_id":"output31-outputs-0","key":"XDmDzLxrqe"}],"identifier":"output31-outputs","html_id":"output31-outputs","key":"IiWRdVSqZx"}],"label":"output31","identifier":"output31","html_id":"output31","key":"MlGwRjCCgJ"},{"type":"block","children":[{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"inlineCode","value":"colorscale","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"key":"ks7FwC2UFQ"}],"key":"sTZksqmsHn"},{"type":"paragr