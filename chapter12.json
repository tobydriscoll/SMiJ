"clencurt","key":"miwPBcy6c9"}],"key":"cInXpC7661"},{"type":"heading","depth":3,"position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"text","value":"Output 30b","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"HrjJjOBhQV"}],"identifier":"output-30b","label":"Output 30b","html_id":"output-30b","implicit":true,"key":"nKELehPpRi"}],"key":"v3cOmsaP9i"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"julia","executable":true,"value":"p30(clencurt)","identifier":"output30b-code","html_id":"output30b-code","key":"QRxzpdcsAr"},{"type":"outputs","id":"j-wdPwvtR8VpkYpDNL8nw","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":4,"metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"e0eef1597760d6ac0f039719b82f0861","path":"https://tobydriscoll.net/SMiJ/build/e0eef1597760d6ac0f039719b82f0861.png"},"text/html":{"content_type":"text/html","hash":"01d8487cf88f1a0b53e050634d48e57a","path":"https://tobydriscoll.net/SMiJ/build/01d8487cf88f1a0b53e050634d48e57a.html"}}},"identifier":"output30b-outputs-0","html_id":"output30b-outputs-0","key":"pWPVzDd6HB"}],"identifier":"output30b-outputs","html_id":"output30b-outputs","key":"vnIHxdK289"}],"label":"output30b","identifier":"output30b","html_id":"output30b","key":"VdGrr1M2zN"},{"type":"block","children":[{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Extended precision","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"INAEbWz6rO"}],"key":"Jgu02D62MZ"},{"type":"paragraph","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"Double precision is called ","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"Bc9tyrJ89K"},{"type":"inlineCode","value":"Float64","position":{"start":{"line":78,"column":1},"en