  use `chebweights`, `clencurt`, or `gauss` as the argument\n\"\"\"\nfunction p30(quadrule=chebweights)\n    # Computation: various values of N, four functions:\n    Nmax = 50\n    funs = [x -> abs(x)^3         x -> exp(-x^(-2));\n            x -> 1 / (1 + x^2)    x -> x^10]\n    ints = [1/2 2*(exp(-1) + sqrt(π) * (erf(1) - 1));  π/2 2/11]\n    E = zeros(2, 2, Nmax)\n    for N = 1:Nmax\n        x, w = quadrule(N)\n        for (i, f) in pairs(funs)\n            E[i, N] = abs(dot(w, f.(x)) - ints[i])\n        end\n    end\n\n    # Plot results:\n    fig = Figure()\n    titles = [L\"|x|^3\"  L\"\\exp(-x^2)\"; L\"1/(1+x^2)\"  L\"x^{10}\"]\n    ax = [Axis(fig[i, j]; title=titles[i, j], yscale=log10) for i in 1:2, j in 1:2]\n    linkaxes!(ax...)\n    @. E[iszero(E)] = NaN\n    for (i, ax) in pairs(ax)\n        scatterlines!(ax, 1:Nmax, E[i, :])\n    end\n    ax[1, 1].ylabel = ax[2, 1].ylabel = \"error\"\n    ax[2, 1].xlabel = ax[2, 2].xlabel = L\"N\"\n    return fig\nend\n\nfunction chebweights(N)\n    i = 1:N\n    D, x = cheb(N)\n    x = x[i]\n    w = inv(D[i, i])[1, :]\n    return x, w\nend","lang":"julia","showLineNumbers":true,"label":"p30","identifier":"p30","filename":"p30","html_id":"p30","key":"vDX5lrOuC6"}],"key":"vjq59U232C"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"That structure in ","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"COFdjatX7L"},{"type":"crossReference","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Program 30","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"YGeSettiCr"}],"identifier":"p30","label":"p30","kind":"code","template":"Code","resolved":true,"html_id":"p30","key":"Scpdar3mA8"},{"type":"text","value":" makes it easy to replace the default quadrature formula with the other two in the chapter.","position":{"start":{"line":21,"co