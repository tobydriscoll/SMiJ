":"singular value decomposition","EVD":"eigenvalue decomposition","SPD":"symmetric positive definite","HPD":"hermitian positive definite","PDE":"partial differential equation","ODE":"ordinary differential equation","FFT":"fast Fourier transform"},"source_url":"https://github.com/tobydriscoll/SpectralMethodsTrefethen.jl/blob/main/chapter4.md","edit_url":"https://github.com/tobydriscoll/SpectralMethodsTrefethen.jl/edit/main/chapter4.md","exports":[{"format":"md","filename":"chapter4.md","url":"/build/chapter4-49b5125005df3a086f3690da863d36b9.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Program 7","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"zd3P0n04Tp"}],"identifier":"program-7","label":"Program 7","html_id":"program-7","implicit":true,"key":"dYzNTOBjdS"},{"type":"include","file":"SpectralMethodsTrefethen/src/scripts/p7.jl","literal":true,"children":[{"type":"code","value":"using CairoMakie, LaTeXStrings\nusing ForwardDiff, SpectralMethodsTrefethen\n\"p7 - accuracy of periodic spectral differentiation\"\nfunction p7(Nmax=50)\n    # Compute derivatives for various values of N:\n    N = 6:2:Nmax\n    funs = [x -> abs(sin(x))^3            x -> exp(-sin(x / 2)^(-2));\n            x -> 1 / (1 + sin(x / 2)^2)   x -> sin(10x)]\n    E = zeros(2, 2, length(N))\n    for (k, N) in enumerate(N)\n        x, D, _ = fourier(N)\n        for (i, f) in pairs(funs)\n            v = f.(x)\n            vprime = ForwardDiff.derivative.(f, x)\n            E[i, k] = maximum(abs, D * v - vprime)\n        end\n    end\n\n    # Plot results:\n    titles = [L\"|\\sin(x)|^3\" L\"\\exp(-\\sin^{-2}(x/2))\"; L\"1/(1+\\sin^2(x/2))\" L\"\\sin(10x)\"]\n    fig = Figure()\n    ax = [Axis(fig[i, j]; title=titles[i, j], yscale=log10) for i in 1:2, j in 1:2]\n    linkaxes!(ax...)\n    for (i, ax) in pairs(ax)\n        scatterlines!(ax, N, E[i, :])\n    end\n    ax[1, 1].ylabel = ax[2, 1].ylabel = \"error\"\n    ax[2, 1].xlabel = ax[2, 2].xlabel = L\"N\"\n    return fig\nend","lang":"julia","showLineNumbers":true,"label":"p7","identifier":"p7","filename":"p7","html_id":"p7","key":"OLvseIAjH6"}],"key":"sWhOl8XIMD"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"One of my favorite perks in Makie is the ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"HjwwBr1LAg"},{"type":"inlineCode","value":"linkaxes!","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"AgBDVJpbwc"},{"type":"text","value":" function, which tells the renderer to give all the linked axes the same limits. That’s used in the output (like in the original) to make it instantly clear how much slower convergence is in the top two cases:","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"sVJXV0rAHY"}],"key":"v8w5Tz5CcZ"},{"type":"heading","depth":3,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Output 7","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"mj2du8nK7Z"}],"identifier":"output-7","label":"Output 7","html_id":"output-7","implicit":true,"key":"Up9uh9OyKh"}],"key":"bOfrEvtJGc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"julia","executable":true,"value":"using SpectralMethodsTrefethen\nfig = p7()","identifier":"output7-code","html_id":"output7-code","key":"iYzHAeOgbV"},{"type":"outputs","id":"Q8HemLGF4QAO5_T2r6bz0","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":1,"metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"9d8d2fed47866013e992ade1f0ae47f7","path":"/build/9d8d2fed47866013e992ade1f0ae47f7.png"},"text/html":{"content_type":"text/html","ha