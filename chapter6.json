tml_id":"cheb","children":[{"type":"code","value":"\"\"\"\n    cheb(N)\nChebyshev differentiation matrix and grid.\n\"\"\"\nfunction cheb(N)\n    (N == 0) && return zeros(1, 1), [1.0]\n    x = [sinpi(k / 2N) for k in N:-2:-N]\n    c(i) = (i == 0 || i == N) ? 2 : 1\n    neg1(i) = iseven(i) ? 1 : -1\n    # compute the off-diagonal entries\n    D = zeros(N+1, N+1)\n    for i in 0:N, j in 0:N\n        if i != j\n            D[i+1, j+1] = neg1(i+j) * c(i) / (c(j) * (x[i+1] - x[j+1]))\n        end\n    end\n    # negative sum trick to get the diagonal entries\n    for i in 0:N\n        D[i+1, i+1] = -sum(D[i+1, :])\n    end\n    return D, x\nend","lang":"julia","showLineNumbers":true,"label":"cheb","identifier":"cheb","filename":"cheb","html_id":"cheb","key":"E7112hPiLf"}],"key":"n5OlYlLojy"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"There is an algorithmic difference in my implementation on line 7, which computes the Chebyshev points via","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"AHx6l6bJcz"}],"key":"GVtDmczEag"},{"type":"math","value":"x_j = -\\sin \\left(\\frac{k \\pi}{2N}\\right), \\\nk = -N, -N+2, \\ldots, N-2, N.","html":"<span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><msub><mi>x</mi><mi>j</mi></msub><mo>=</mo><mo>−</mo><mi>sin</mi><mo>⁡</mo><mrow><mo fence=\"true\">(</mo><mfrac><mrow><mi>k</mi><mi>π</mi></mrow><mrow><mn>2</mn><mi>N</mi></mrow></mfrac><mo fence=\"true\">)</mo></mrow><mo separator=\"true\">,</mo><mtext> </mtext><mi>k</mi><mo>=</mo><mo>−</mo><mi>N</mi><mo separator=\"true\">,</mo><mo>−</mo><mi>N</mi><mo>+</mo><mn>2</mn><mo separator=\"true\">,</mo><mo>…</mo><mo separator=\"true\">,</mo><mi>N</mi><mo>−</mo><mn>2</mn><mo separator=\"true\">,</mo><mi>N</mi><mi mathvariant=\"normal\">.</mi></mrow><annotation encodi