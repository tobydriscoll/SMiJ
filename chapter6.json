ype":"inlineCode","value":"||","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"bptJ7lG2wF"},{"type":"text","value":", which skips the second clause if the first is true. For example,","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"bvpbcIMt7a"}],"key":"SEsYWphg2R"},{"type":"code","lang":"julia","value":"(max_error < tol) || @warn(\"Error exceeds tolerance.\")","position":{"start":{"line":51,"column":1},"end":{"line":53,"column":1}},"key":"vwEaxrqVyR"}],"icon":false,"class":"dropdown","key":"rOALh38Ee5"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Minimizing allocations","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"Whe7T7XOdx"}],"key":"fRmrBRoFD6"},{"type":"paragraph","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"There is a subtle difference between the given line 9,","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"YQDMWs87C3"}],"key":"zSbo6sbeWV"},{"type":"code","lang":"julia","value":"@. c[2:2:end] = -c[2:2:end]","position":{"start":{"line":61,"column":1},"end":{"line":63,"column":1}},"key":"Pm0E8CXgqh"},{"type":"paragraph","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"and the functionally equivalent line","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"S5H6o2wv12"}],"key":"kasfviHFVM"},{"type":"code","lang":"julia","value":"c[2:2:end] = -c[2:2:end]","position":{"start":{"line":67,"column":1},"end":{"line":69,"column":1}},"key":"J3JJLraLcf"},{"type":"paragraph","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"The former version implies a copy of the vector from the right-hand side to the left-hand side. But the second version implies an assignment to a subarray of the vector on the left-hand side, thus requiring extra allocation of temporary storage for the subarray.","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"FWQoZ6UJbx"}],"key":"MwXOBNpORV"},{"type":"paragraph","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"In fact, even the first version requires allocations for the right-hand side we don’t need. The fastest version of this line is a loop:","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"tRF2Q4pF6u"}],"key":"kEDYhiGeUO"},{"type":"code","lang":"julia","value":"for j in 2:2:length(c)\n    c[j] = -c[j]\nend","position":{"start":{"line":75,"column":1},"end":{"line":79,"column":1}},"key":"Jz2Rw3G3KF"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"Coders in MATLAB and Python are (rightly) taught to be wary of loops, but in Julia, they carry no intrinsic penalty—sometimes, quite the opposite. I chose the more compact syntax only because efficiency is not important in this context.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"U4snG3hGxL"}],"key":"w2suvRXhRr"}],"icon":false,"class":"dropdown","key":"WSg1NivQNF"},{"type":"heading","depth":2,"position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"Program 11","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"FB9lk7Mc8Z"}],"identifier":"program-11","label":"Program 11","html_id":"program-11","implicit":true,"key":"XLpUJCxd8P"},{"type":"include","file":"SpectralMethodsTrefethen/src/scripts/p11.jl","literal":true,"children":[{"type":"code","value":"using CairoMakie, LaTeXStrings\nusing SpectralMethodsTrefethen, ForwardDiff\n\"p11 - Chebyshev differentation of a smooth function\"\nfunction p11()\n    f(x) = exp(x) * sin(5x)\n    df_dx(x) = ForwardDiff.derivative(f, x)\n    fig = Figure()\n    for (i, N) in enumerate([10, 20])\n        D, x = cheb(N)\n        v = f.(x)\n\n        Axis(fig[i, 1]; title=latexstring(\"\\$u(x),\\\\,  N=$N\\$\"))\n        scatter!(fig[i, 1], x, v)\n        lines!(fig[i, 1], -1..1, f)\n\n        error = D * v - df_dx.(x)\n        Axis(fig[i, 2]; title=latexstring(\"error in \\$u'(x),\\\\,  N=$N\\$\"))\n        scatterlines!(fig[i, 2], x, error; linestyle=:dot)\n    end\n    return fig\nend","lang":"julia","showLineNumbers":true,"label":"p11","identifier":"p11","filename":"p11","html_id":"p11","key":"FOrWgz3ILc"}],"key":"KqkpdmcO5m"},{"type":"paragraph","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"There are no new Julia tricks here, but there is a minor stylistic change from Output 11 in ","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"YNBm02xZW2"},{"type":"emphasis","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"abbreviation","title":"Spectral Methods in MATLAB","children":[{"type":"text","value":"SMiM","key":"IiLolL7FeI"}],"key":"YSJLnA7uRO"}],"key":"XL6LlyLH1p"},{"type":"text","value":".","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"gx0KaK8R1w"}],"key":"FSGFY92UgK"},{"type":"heading","depth":3,"position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"text","value":"Output 11","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"Dnhnt5d08u"}],"identifier":"output-11","label":"Output 11","html_id":"output-11","implicit":true,"key":"V80ymOOOQ7"}],"key":"wYH2Voupdf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"julia","executable":true,"value":"using SpectralMethodsTrefethen\np11()","identifier":"output11-code","html_id":"output11-code","key":"OlL8CebvcU"},{"type":"outputs","id":"gyil59TA0d4627KCGu_TP","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":1,"metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"d10d3c156bca0aef0e84ebaa4dc23685","path":"https://tobydriscoll.net/build/d10d3c156bca0aef0e84ebaa4dc23685.png"},"text/html":{"content_type":"text/html","hash":"af3a0d6a453e7721267203a0537f8e63","path":"https://tobydriscoll.net/build/af3a0d6a453e7721267203a0537f8e63.html"}}},"identifier":"output11-outputs-0","html_id":"output11-outputs-0","key":"DLmPPBAu8p"}],"identifier":"output11-outputs","html_id":"output11-outputs","key":"cWfz8bej3H"}],"label":"output11","identifier":"output11","html_id":"output11","key":"cFzxBEhbYZ"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"text","value":"The solid curves on the left column show the given exact function. In the right column, the original program connected the dots with solid lines again, but only as a visual guide—the lines don’t mean anything, really. I’ve had students get confused on that point, so I’ve used a dotted line to connect the points, just to hint that something is different.","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"RIPN84L9hu"}],"key":"MpDiczuKHi"},{"type":"heading","depth":2,"position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"children":[{"type":"text","value":"Program 12","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"UD904Rvrr8"}],"identifier":"program-12","label":"Program 12","html_id":"program-12","implicit":true,"key":"sq7lRZqj8s"},{"type":"include","file":"SpectralMethodsTrefethen/src/scripts/p12.jl","literal":true,"children":[{"type":"code","value":"using CairoMakie, LaTeXStrings, SpectralMethodsTrefethen\n\"p12 - accuracy of Chebyshev spectral differentiation (compare p7)\"\nfunction p12(Nmax = 50)\n    # Compute derivatives for various values of N:\n    # 3rd deriv in BV, C^∞; analytic, polynomial\n    funs = [x -> abs(x)^3            x -> exp(-x^(-2));\n            x -> 1 / (1 + x^2)       x -> x^10]\n    E = zeros(2, 2, Nmax)\n    for N in 1:Nmax\n        D, x = cheb(N)\n        for (i, f) in pairs(funs)\n            v = f.(x)\n            df_dx = ForwardDiff.derivative.(f, x)\n            E[i, N] = maximum(abs, D * v - df_dx)\n        end\n    end\n\n    # Plot results:\n    fig = Figure()\n    titles = [L\"|x|^3\"  L\"\\exp(-x^2)\"; L\"1/(1+x^2)\"  L\"x^{10}\"]\n    ax = [Axis(fig[i, j]; title=titles[i, j], yscale=log10) for i in 1:2, j in 1:2]\n    linkaxes!(ax...)\n    for (i, ax) in pairs(ax)\n        scatterlines!(ax, 1:Nmax, E[i, :])\n    end\n    ax[1, 1].ylabel = ax[2, 1].ylabel = \"error\"\n    ax[2, 1].xlabel = ax[2, 2].xlabel = L\"N\"\n    return fig\nend","lang":"julia","showLineNumbers":true,"label":"p12","identifier":"p12","filename":"p12","html_id":"p12","key":"wIjiUuvJTM"}],"key":"GsBsBMZO6c"},{"type":"paragraph","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"text","value":"You’re meant to compare these plots to ","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"FjMbU1ti7P"},{"type":"crossReference","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"text","value":"Output 7","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"qziwuZ4Gor"}],"identifier":"output7","label":"output7","kind":"block:notebook-code","template":"Notebook-code","resolved":true,"html_id":"output7","remote":true,"url":"/chapter4","dataUrl":"/chapter4.json","key":"NOBk2bIaUw"},{"type":"text","value":" for periodic functions.","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"ynP8mxYrKf"}],"key":"EHa0GZZ0XI"},{"type":"heading","depth":3,"position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"children":[{"type":"text","valu