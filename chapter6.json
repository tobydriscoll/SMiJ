pan class=\"mord mathnormal\" style=\"margin-right:0.10903em;\">N</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.8778em;vertical-align:-0.1944em;\"></span><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.10903em;\">N</span><span class=\"mord\">.</span></span></span></span></span>","key":"QK94C5QV5p"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"This formula is a simple trigonometric identity away from the standard cosine expression, but it has the advantage of producing nodes that are ","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"DIvz7dHFNd"},{"type":"cite","url":"doi:10.1145/365723.365727","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"perfectly symmetric around zero","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"NBax0kc8e3"}],"kind":"narrative","label":"Weideman_2000","identifier":"doi:10.1145/365723.365727","enumerator":"1","key":"xEfpRFmrc8"},{"type":"text","value":" in floating-point arithmetic.","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"UTUCjxjdfo"}],"key":"ImgcmlMyAe"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Short-circuit logic","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"mhXtrrM1N4"}],"key":"zSXO3E0TmG"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Line 6 might look odd. It takes advantage of the ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"Tue6XmIDht"},{"type":"crossReference","label":"short-circuiting","identifier":"term-short-circuiting","children":[{"type":"text","value":"short-circuiting","key":"aqIQYuc85i"}],"kind":"definitionTerm","template":"{name}","resolved":true,"html_id":"term-short-circuiting","remote":true,"url":"/glossary","dataUrl":"/glossary.json","key":"Zah4TGSjYk"},{"type":"text","value":" logical AND, ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"QMxuX5uHlI"},{"type":"inlineCode","value":"&&","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"vCwJsOTjRX"},{"type":"text","value":". Short-circuiting means that if the first clause is false, then the second clause isn’t evaluated, because the entire expression must be false anyway. This is a nice feature to avoid pesky runtime errors in conditional expressions, as in","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"zTa8lcwATQ"}],"key":"AkY7U6iypK"},{"type":"code","lang":"julia","value":"if (length(x) >= 5) && (x[5] > 0)","position":{"start":{"line":37,"column":1},"end":{"line":39,"column":1}},"key":"CBrwA06dgM"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Here, though, it’s being used as a compact—some would say cryptic—alternative to the construction","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"rrEdEu1g8h"}],"key":"GhSaSoJ1PD"},{"type":"code","lang":"julia","value":"if N == 0\n    return zeros(1, 1), [1.0]\nend","position":{"start":{"line":43,"column":1},"end":{"line":47,"column":1}},"key":"OFnfjplwtv"},{"type":"paragraph","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"A similar trick works with the OR operator ","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"J9I6nMvOCM"},{"type":"inlineCode","value":"||","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"h9TRiUJr24"},{"type":"text","value":", which skips the second clause if the first is true. For example,","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"EViMghHZ8x"}],"key":"w02QvICDVM"},{"type":"code","lang":"julia","value":"(max_error < tol) || @warn(\"Error exceeds tolerance.\")","position":{"start":{"line":51,"column":1},"end":{"line":53,"column":1}},"key":"YlgnTqwzq9"}],"icon":false,"class":"dropdown","key":"WuS0drMF9s"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Minimizing allocations","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"T6D03nR9GB"}],"key":"nAt6H3nsU3"},{"type":"paragraph","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"There is a subtle difference between the given line 9,","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"bdEoUCuilT"}],"key":"r4FbkrA1cc"},{"type":"code","lang":"julia","value":"@. c[2:2:end] = -c[2:2:end]","position":{"start":{"line":61,"column":1},"end":{"line":63,"column":1}},"key":"swhefwFxDQ"},{"type":"paragraph","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"and the functionally equivalent line","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"j6DJaYUhxI"}],"key":"ECSHQLFVdp"},{"type":"code","lang":"julia","value":"c[2:2:end] = -c[2:2:end]","position":{"start":{"line":67,"column":1},"end":{"line":69,"column":1}},"key":"V8EkpXxrGB"},{"type":"paragraph","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"The former version implies a copy of the vector from the right-hand side to the left-hand side. But the second version implies an assignment to a subarray of the vector on the left-hand side, thus requiring extra allocation of temporary storage for the subarray.","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"e6aJAxcTyd"}],"key":"gU7OtXuzf3"},{"type":"paragraph","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"In fact, even the first version requires allocations for the right-hand side we don’t need. The fastest version of this line is a loop:","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"cYY4MFKebZ"}],"key":"f32ZhjCfJj"},{"type":"code","lang":"julia","value":"for j in 2:2:length(c)\n    c[j] = -c[j]\nend","position":{"start":{"line":75,"column":1},"end":{"line":79,"column":1}},"key":"sqCQnYdLW7"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"Coders in MATLAB and Python are (rightly) taught to be wary of loops, but in Julia, they carry no intrinsic penalty—sometimes, quite the opposite. I chose the more compact syntax only because efficiency is not important in this context.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"QIuCjCVBcp"}],"key":"wkBhNKSTTG"}],"icon":false,"class":"dropdown","key":"WFai01TxT5"},{"type":"heading","depth":2,"position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"Program 11","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"jE9OyQe1GF"}],"identifier":"program-11","label":"Program 11","html_id":"program-11","implicit":true,"key":"f4Z12EnBGf"},{"type":"include","file":"SpectralMethodsTrefethen/src/scripts/p11.jl","literal":true,"children":[{"type":"code","value":"using CairoMakie, LaTeXStrings\nusing SpectralMethodsTrefethen, ForwardDiff\n\"p11 - Chebyshev differentation of a smooth function\"\nfunction p11()\n    f(x) = exp(x) * sin(5x)\n    df_dx(x) = ForwardDiff.derivative(f, x)\n    fig = Figure()\n    for (i, N) in enumerate([10, 20])\n        D, x = cheb(N)\n        v = f.(x)\n\n        Axis(fig[i, 1]; title=latexstring(\"\\$u(x),\\\\,  N=$N\\$\"))\n        scatter!(fig[i, 1], x, v)\n        lines!(fig[i, 1], -1..1, f)\n\n        error = D * v - df_dx.(x)\n        Axis(fig[i, 2]; title=latexstring(\"error in \\$u'(x),\\\\,  N=$N\\$\"))\n        scatterlines!(fig[i, 2], x, error; linestyle=:dot)\n    end\n    return fig\nend","lang":"julia","showLineNumbers":true,"label":"p11","identifier":"p11","filename":"p11","html_id":"p11","key":"crX8hgTGqq"}],"key":"INzFSvNbRv"},{"type":"paragraph","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"There are no new Julia tricks here, but there is a minor stylistic change from Output 11 in ","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"OxCSSHteRV"},{"type":"emphasis","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"abbreviation","title":"Spectral Methods in MATLAB","children":[{"type":"text","value":"SMiM","key":"cTLP3rnvoh"}],"key":"VYpoYl1Ikg"}],"key":"bVnZbdAZh7"},{"type":"text","value":".","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"V7xFkW61Oh"}],"key":"P5mR5yYX66"},{"type":"heading","depth":3,"position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"text","value":"Output 11","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"zv8AXdL1BY"}],"identifier":"output-11","label":"Output 11","html_id":"output-11","implicit":true,"key":"SuSl9GdLyi"}],"key":"GK6WQPE80Q"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"julia","executable":true,"value":"using SpectralMethodsTrefethen\np11()","identifier":"output11-code","html_id":"output11-code","key":"EZihR4GAT5"},{"type":"outputs","id":"-fU_H1b7lrawTMh7uiqbq","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":1,"metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"d10d3c156bca0aef0e84ebaa4dc23685","path":"https://tobydriscoll.net/SMiJ/build/d10d3c156bca0aef0e84ebaa4dc23685.png"},"text/html":{"content_type":"text/html","hash":"af3a0d6a453e7721267203a0537f8e63","path":"https://tobydriscoll.net/SMiJ/build/af3a0d6a453e7721267203a0537f8e63.html"}}},"identifier":"output11-outputs-0","html_id":"output11-outputs-0","key":"S3rcxg4YlH"}],"identifier":"output11-outputs","html_id":"output11-outputs","key":"Tx7QycEDly"}],"label":"output11","identifier":"output11","html_id":"output11","key":"Z4sgoxsRT2"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"text","value":"The solid curves on the left column show the given exact function. In the right column, the original program connected the dots with solid lines again, but only as a visual guide—the lines don’t mean anything, really. I’ve had students get confused on that point, so I’ve used a dotted line to connect the points, just to hint that something is different.","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"s9lupqAHgS"}],"key":"cr6UvwVTh9"},{"type":"heading","depth":2,"position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"children":[{"type":"text","value":"Program 12","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"eOCcrWio1Q"}],"identifier":"program-12","label":"Program 12","html_id":"program-12","implicit":true,"key":"LlCDyF7MXQ"},{"type":"include","file":"SpectralMethodsTrefethen/src/scripts/p12.jl","literal":true,"children":[{"type":"code","value":"using CairoMakie, LaTeXStrings, SpectralMethodsTrefethen\n\"p12 - accuracy of Chebyshev spectral differentiation (compare p7)\"\nfunction p12(Nmax = 50)\n    # Compute derivatives for various values of N:\n    # 3rd deriv in BV, C^∞; analytic, polynomial\n    funs = [x -> abs(x)^3            x -> exp(-x^(-2));\n            x -> 1 / (1 + x^2)       x -> x^10]\n    E = zeros(2, 2, Nmax)\n    for N in 1:Nmax\n        D, x = cheb(N)\n        for (i, f) in pairs(funs)\n            v = f.(x)\n            df_dx = ForwardDiff.derivative.(f, x)\n            E[i, N] = maximum(abs, D * v - df_dx)\n        end\n    end\n\n    # Plot results:\n    fig = Figure()\n    titles = [L\"|x|^3\"  L\"\\exp(-x^2)\"; L\"1/(1+x^2)\"  L\"x^{10}\"]\n    ax = [Axis(fig[i, j]; title=titles[i, j], yscale=log10) for i in 1:2, j in 1:2]\n    linkaxes!(ax...)\n    for (i, ax) in pairs(ax)\n        scatterlines!(ax, 1:Nmax, E[i, :])\n    end\n    ax[1, 1].ylabel = ax[2, 1].ylabel = \"error\"\n    ax[2, 1].xlabel = ax[2, 2].xlabel = L\"N\"\n    return fig\nend","lang":"julia","showLineNumbers":true,"label":"p12","identifier":"p12","filename":"p12","html_id":"p12","key":"O3WZJonQQT"}],"key":"JZifTsN6Vu"},{"type":"paragraph","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"text","value":"You’re meant to compare these plots to ","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"e65ThuoME1"},{"type":"crossReference","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"text","value":"Output 7","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"EnxPvx7Hva"}],"identifier":"output7","label":"output7","kind":"block:notebook-code","template":"Notebook-code","resolved":true,"html_id":"output7","remote":true,"url":"/chapter4","dataUrl":"/chapter4.json","key":"fICeLFlZ5r"},{"type":"text","value":" for periodic functions.","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"OBr1NYhntp"}],"key":"Tc44p60rU8"},{"type":"heading","depth":3,"position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"children":[{"typ