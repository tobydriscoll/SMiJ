lue problem","SVD":"singular value decomposition","EVD":"eigenvalue decomposition","SPD":"symmetric positive definite","HPD":"hermitian positive definite","PDE":"partial differential equation","ODE":"ordinary differential equation","FFT":"fast Fourier transform"},"source_url":"https://github.com/tobydriscoll/SpectralMethodsTrefethen.jl/blob/main/chapter6.md","edit_url":"https://github.com/tobydriscoll/SpectralMethodsTrefethen.jl/edit/main/chapter6.md","exports":[{"format":"md","filename":"chapter6.md","url":"https://tobydriscoll.net/build/chapter6-409a3d440cefb58f2909a8bf74fbef26.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"cheb","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"yNDa5GzcTM"}],"label":"chapter6","identifier":"chapter6","html_id":"chapter6","key":"vvcKiFph75"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"This is the first formal function in ","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"FnY6MG9rYi"},{"type":"emphasis","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"abbreviation","title":"Spectral Methods in MATLAB","children":[{"type":"text","value":"SMiM","key":"GIVvdHsVtK"}],"key":"PMOcoBPR1p"}],"key":"KfxOuIG62A"},{"type":"text","value":", and I have defined it in ","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"krnvQ7pGq5"},{"type":"inlineCode","value":"SpectralMethodsTrefethen","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"nGMzDM4ri6"},{"type":"text","value":".","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"rHRquK7htw"}],"key":"Kd8EMmZu4V"},{"type":"include","file":"SpectralMethodsTrefethen/src/cheb.jl","literal":true,"html_id":"cheb","children":[{"type":"code","value":"\"\"\"\n    cheb(N)\nChebyshev differentiation matrix and grid.\n\"\"\"\nfunction cheb(N)\n    (N == 0) && return zeros(1, 1), [1.0]\n    x = [sinpi(k / 2N) for k in N:-2:-N]\n    c(i) = (i == 0 || i == N) ? 2 : 1\n    neg1(i) = iseven(i) ? 1 : -1\n    # compute the off-diagonal entries\n    D = zeros(N+1, N+1)\n    for i in 0:N, j in 0:N\n        if i != j\n            D[i+1, j+1] = neg1(i+j) * c(i) / (c(j) * (x[i+1] - x[j+1]))\n        end\n    end\n    # negative sum trick to get the diagonal entries\n    for i in 0:N\n        D[i+1, i+1] = -sum(D[i+1, :])\n    end\n    return D, x\nend","lang":"julia","showLineNumbers":true,"label":"cheb","identifier":"cheb","filename":"cheb","html_id":"cheb","key":"MoAO77CGjq"}],"key":"Rsx56amXmV"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"There is an algorithmic difference in my implementation on line 7, which computes the Chebyshev points via","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"iKjeXBRNrk"}],"key":"NTqUsIStxf"},{"type":"math","value":"x_j = -\\sin \\left(\\frac{k \\pi}{2N}\\right), \\\nk = -N, -N+2, \\ldots, N-2, N.","html":"<span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><msub><mi>x</mi><mi>j</mi></msub><mo>=</mo><mo>−</mo><mi>sin</mi><mo>⁡</mo><mrow><mo fence=\"true\">(</mo><mfrac><mrow><mi>k</mi><mi>π</mi></mrow><mrow><mn>2</mn><mi>N</mi></mrow></mfrac><mo fence=\"true\">)</mo></mrow><mo separator=\"true\">,</mo><mtext> </mtext><mi>k</mi><mo>=</mo><mo>−</mo><mi>N</mi><mo separator=\"true\">,</mo><mo>−</mo><mi>N</mi><mo>+</mo><mn>2</mn><mo separator=\"true\">,</mo><mo>…</mo><mo separator=\"true\">,</mo><mi>N</mi><mo>−</mo><mn>2</mn><mo separator=\"true\">,</mo><mi>N</mi><mi mathvariant=\"normal\">.</mi><